# 复制成 .env 使用（.env 不会提交到 git）

# 数据库：买了云端数据库后只改这一行
DATABASE_URL=postgresql://pathfinder:pathfinder@localhost:5432/pathfinder

# LLM：DeepSeek（https://platform.deepseek.com）。OpenAI 兼容，换别家只改这三行
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_THINKING=disabled   # deepseek-flash 默认开思考，不关会慢 5–10 倍
# 改回 Kimi（月之暗面）：LLM_API_KEY 换成 Kimi 的 key，并改成下面三行
#   LLM_BASE_URL=https://api.moonshot.cn/v1
#   LLM_MODEL=kimi-k3
#   LLM_THINKING=disabled   （Kimi 要关思考，不然每次 ~30 秒）
# 也可以把 Kimi key 先存在这里：# KIMI_KEY_BACKUP=

# Embedding 与 Rerank：硅基流动（https://cloud.siliconflow.cn 申请，bge 系列开源模型的 API 版）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 邮件（寄北大邮箱验证码）：163 或 QQ 邮箱的 SMTP，由「最伟大的」提供
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# 搜索时用大模型做处境抽取（改错字＋抽条件）；不设＝关键词版
SEARCH_LLM_PARSE=1

# agent 层时限与并发（DeepSeek）
AGENT_TIMEOUT=45
LLM_CONCURRENCY=8   # DeepSeek 没限流；10/17 实测 2→8 整次平均 12.3→9.9 秒
