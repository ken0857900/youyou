# Put these in the repository root .env (never commit real keys).
DATABASE_URL=postgresql://pathfinder:pathfinder@127.0.0.1:5432/pathfinder
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
RAG_TIMEOUT=12
RAG_CHUNK_VERSION=decision-v1
# Optional: set only after running validation calibration.
# RAG_CALIBRATION_FILE=RAG/reports/calibration.json
# RAG_RELEVANCE_THRESHOLD=0.5
# Isolated test schema is created inside this database and dropped afterward.
# RAG_TEST_DATABASE_URL=postgresql://pathfinder:pathfinder@127.0.0.1:5432/pathfinder_test
# Paid model verification (off by default):
# RAG_TEST_LIVE=1
